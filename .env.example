# انسخ هالملف لـ .env للتشغيل المحلي (npm start). على Render حط نفس القيم بـ Environment.
APP_PASSWORD=
GEMINI_API_KEY=
# اختياري
SESSION_SECRET=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
# لتخزين دائم بقاعدة Postgres (مثلاً Neon المجاني): postgres://...
DATABASE_URL=
